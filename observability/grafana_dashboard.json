            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_request_duration_seconds_sum[2m])) by (route) / sum(rate(http_request_duration_seconds_count[2m])) by (route)",
